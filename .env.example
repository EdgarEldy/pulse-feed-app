# Copy this file to `.env` (which is git-ignored) and adjust values for your machine/backend.
# `scripts/set-env.js` reads `.env` at build/serve time and writes it into src/environments/.
API_BASE_URL=http://localhost:3000

# OAuth web client ID from the Google Cloud Console (APIs & Services > Credentials),
# passed to @capawesome/capacitor-google-sign-in's initialize({ clientId }) call.
# This must be the *web* client ID even on Android/iOS builds, per that plugin's
# own docs; the Android/iOS client IDs are configured separately, at the native
# project level, and are not read from this file.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com
